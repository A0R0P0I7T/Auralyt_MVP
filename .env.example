# Auralyt MVP — Engine 1 Configuration

# Environment & Server
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Database (Default: local SQLite with async aiosqlite; PostgreSQL supported via postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./auralyt.db

# Crawler Limits & Safety (Configurable)
DEFAULT_PAGE_LIMIT=30
MAX_PAGE_LIMIT=50
MAX_CRAWL_DEPTH=3
REQUEST_TIMEOUT_SECONDS=15
MAX_RESPONSE_SIZE_BYTES=5242880
PER_HOST_CONCURRENCY=3
PER_HOST_DELAY_SECONDS=0.5
USER_AGENT=AuralytBot/1.0 (+https://auralyt.ai/bot)

# Browser Rendering Fallback (DynamicFetcher)
# Disabled by default in production. In production, requires BROWSER_ISOLATION_MODE="egress_proxy" or "container_sandbox"
ALLOW_BROWSER_FALLBACK=false
BROWSER_ISOLATION_MODE=none
BROWSER_PROXY_URL=

# Network Egress & DNS-Rebinding Protection
# In production, EGRESS_PROXY_URL is mandatory (crawler fails closed if absent).
# Example: http://egress-proxy:4750
EGRESS_PROXY_URL=
ENFORCE_EGRESS_PROXY=false

# Optional LLM Enhancement (Disabled by default, deterministic rules used)
LLM_ENABLED=false
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

